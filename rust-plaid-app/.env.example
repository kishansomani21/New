# Server Configuration
HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000

# Plaid Configuration
# Get your API keys from https://dashboard.plaid.com/
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
# Options: sandbox, development, production
PLAID_ENV=sandbox

# Database
# SQLite database path (will be created automatically)
DATABASE_URL=sqlite:data/banking.db?mode=rwc
