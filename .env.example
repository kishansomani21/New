# ============================================
# MTD ITSA FINANCIAL ANALYZER - CORE SETTINGS
# ============================================

# Anthropic Claude AI API - REQUIRED
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Drive & Sheets API - REQUIRED
# Follow setup guide in README
GOOGLE_CLIENT_EMAIL=your_service_account_email@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=your_private_key_here
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id
GOOGLE_SHEET_ID=your_google_sheet_id

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# OPTIONAL: BANK API INTEGRATIONS (Legacy)
# ============================================

# Plaid API Credentials
# Get your credentials from: https://dashboard.plaid.com/
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox
NEXT_PUBLIC_PLAID_ENV=sandbox

# GoCardless API Credentials
# Get your credentials from: https://manage.gocardless.com/
GOCARDLESS_ACCESS_TOKEN=your_gocardless_access_token
GOCARDLESS_ENV=sandbox

# TrueLayer API Credentials
# Get your credentials from: https://console.truelayer.com/
TRUELAYER_CLIENT_ID=your_truelayer_client_id
TRUELAYER_CLIENT_SECRET=your_truelayer_client_secret
TRUELAYER_REDIRECT_URI=http://localhost:3000/api/truelayer/callback
