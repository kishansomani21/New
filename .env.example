# Plaid API Credentials
# Get your credentials from: https://dashboard.plaid.com/
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox
NEXT_PUBLIC_PLAID_ENV=sandbox

# GoCardless API Credentials
# Get your credentials from: https://manage.gocardless.com/
GOCARDLESS_ACCESS_TOKEN=your_gocardless_access_token
GOCARDLESS_ENV=sandbox

# TrueLayer API Credentials
# Get your credentials from: https://console.truelayer.com/
TRUELAYER_CLIENT_ID=your_truelayer_client_id
TRUELAYER_CLIENT_SECRET=your_truelayer_client_secret
TRUELAYER_REDIRECT_URI=http://localhost:3000/api/truelayer/callback

# Google Sheets API Credentials
# Follow setup guide: https://developers.google.com/sheets/api/quickstart/nodejs
GOOGLE_CLIENT_EMAIL=your_service_account_email@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=your_private_key_here
GOOGLE_SHEET_ID=your_google_sheet_id

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gmail API Configuration (for sending onboarding emails)
# Follow setup guide in ONBOARDING_SETUP.md
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token
GMAIL_USER=your_email@gmail.com

# Google Clients Sheet (for client tracking)
GOOGLE_CLIENTS_SHEET_ID=your_clients_sheet_id

# Google Forms
GOOGLE_FORM_URL=https://forms.google.com/YOUR_FORM_ID

# Zoho Sign Configuration (for engagement letters)
# Get your access token from: https://www.zoho.com/sign/
ZOHO_SIGN_ACCESS_TOKEN=your_zoho_sign_access_token
ZOHO_SIGN_REGION=eu

# HMRC API Configuration (for VAT Agent Authorization)
# Register at: https://developer.service.hmrc.gov.uk/
HMRC_CLIENT_ID=your_hmrc_client_id
HMRC_CLIENT_SECRET=your_hmrc_client_secret
HMRC_AGENT_REFERENCE_NUMBER=your_agent_reference_number
HMRC_ENV=sandbox
