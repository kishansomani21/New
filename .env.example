# SkillSync Platform Environment Variables

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SkillSync

# Database
DATABASE_URL="file:./dev.db"

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-change-this-in-production

# Stripe Payment (for contact purchases)
STRIPE_SECRET_KEY=your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Pricing Configuration
NEXT_PUBLIC_BASE_CONTACT_PRICE=5.00
NEXT_PUBLIC_POINTS_PER_REVIEW=10
NEXT_PUBLIC_DISCOUNT_RATE=0.01
